# Local MongoDB:      mongodb://127.0.0.1:27017/kwikr
# Atlas (example):    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kwikr
MONGO_URI=mongodb://127.0.0.1:27017/kwikr
# Optional: target specific database without changing the URI (e.g. kwikr or kwikr-checkout)
DB_NAME=kwikr
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000
CLIENT_URL=http://localhost:5173

# Seed sizes (bigger data makes explain() differences visible)
SEED_PRODUCTS=50000
SEED_ORDERS=20000
